{
  "name": "tsncd",
  "version": "0.0.1",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --mode development",
    "watch": "node src/run_watch.ts",
    "build": "webpack --mode production",
    "preview": "webpack serve --mode production --open",
    "server": "node src/run_server.ts",
    "capture": "node src/capture_preview.ts",
    "validate": "node test/validations/run_validations.ts",
    "validate:all": "node test/validations/run_validations.ts --all",
    "test:server-preview": "node test/validations/run_validations.ts --all --name test/server_preview_client.test.ts",
    "test:diagram-theme": "node test/validations/run_validations.ts --all --name test/diagram_theme.test.ts",
    "test:render": "node test/validations/run_validations.ts --all --kind test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mit-zardini-lab/tsncd.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mit-zardini-lab/tsncd/issues"
  },
  "homepage": "https://github.com/mit-zardini-lab/tsncd#readme",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/ws": "^8.18.1",
    "css-loader": "^7.1.3",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@types/mathjax": "^0.0.40",
    "commonjs": "^0.0.1",
    "fs": "^0.0.1-security",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.28",
    "mathjax": "^3.2.2",
    "mathjax-full": "^3.2.2",
    "ws": "^8.19.0"
  }
}
