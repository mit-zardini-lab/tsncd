{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "noEmit": true,

    "types": []
  },
  "include": ["./src/**/*"],
  "exclude": [
    "./src/run_server.ts",
    "./src/run_watch.ts",
    "./src/capture_preview.ts",
    "./src/data_transfer/diagram_server.ts",
    "./src/data_transfer/server_preview_client.ts"
  ]
}
